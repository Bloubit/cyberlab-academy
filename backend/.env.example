APP_NAME="CyberLab Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cyberlab_academy
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=cyberlab

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@cyberlab.academy"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:3000
SESSION_DOMAIN=localhost

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

JWT_SECRET=
JWT_TTL=1440

# ───────────────────────────────────────
# Payment Gateway: Click.uz
# ───────────────────────────────────────
# Register at https://business.click.uz/en to get credentials
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_BASE_URL=https://api.click.uz/v2/merchant

# ───────────────────────────────────────
# Payment Gateway: Payze.io
# ───────────────────────────────────────
# Register at https://payze.io to get credentials
PAYZE_API_KEY=
PAYZE_API_SECRET=
PAYZE_BASE_URL=https://api.payze.io/v1

GOOGLE2FA_SECRET=
