# CyberLab Academy - MVP Environment Configuration
# Copy this file to .env and update values

# Application
APP_NAME="CyberLab Academy"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://cyberlab.academy

# Database
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cyberlab
DB_USERNAME=cyberlab
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Cache & Session
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Mail (Mailgun - Free tier: 1000 emails/month)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_mailgun_username
MAIL_PASSWORD=your_mailgun_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cyberlab.academy"
MAIL_FROM_NAME="CyberLab Academy"

# File Storage
FILESYSTEM_DISK=local

# JWT Authentication
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_TTL=1440

# Sanctum (Laravel API tokens)
SANCTUM_STATEFUL_DOMAINS=cyberlab.academy,www.cyberlab.academy,api.cyberlab.academy

# Frontend
NEXT_PUBLIC_API_URL=https://api.cyberlab.academy/api
NEXT_PUBLIC_WS_URL=wss://api.cyberlab.academy/ws

# Security
HASHING_DRIVER=bcrypt
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.cyberlab.academy

# File Upload
UPLOAD_MAX_FILESIZE=50M
POST_MAX_SIZE=55M
